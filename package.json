{
  "name": "repository_prisma",
  "version": "2.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-zheng-teki/repository_prisma.git"
  },
  "bugs": {
    "url": "https://github.com/ryan-zheng-teki/repository_prisma/issues"
  },
  "homepage": "https://github.com/ryan-zheng-teki/repository_prisma#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.prisma-client-generator.json && node scripts/check-typecheck-programs.js",
    "test": "node scripts/run-tests.js",
    "test:package": "npm run build && node scripts/run-package-smoke.js && node scripts/run-esm-cjs-interop.js",
    "prepare": "prisma generate",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^25.0.10",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild": false,
    "prisma": false,
    "@prisma/engines": false,
    "fsevents": false
  }
}
