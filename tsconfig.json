{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "examples/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "examples/prisma-client-generator/**",
    "src/tests/prisma-client-generator/**"
  ]
}
