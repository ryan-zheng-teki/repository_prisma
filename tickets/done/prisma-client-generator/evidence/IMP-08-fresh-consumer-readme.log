// src/main.ts
import './db';
import { initializePrisma, prisma, runInTransaction, shutdownPrisma, Models } from 'repository_prisma';
import { PostRepository, UserRepository } from './repositories';

const main = async (): Promise<void> => {
  await initializePrisma({ datasourceUrl: 'file:./app.db' });
  const users = new UserRepository();
  const user = await users.create({ data: { email: 'ada-cjs@example.test' } });
  await runInTransaction(async () => {
    await new PostRepository().create({ data: { title: 'Hello', authorId: user.id } });
  });
  await runInTransaction(async () => {
    await users.create({ data: { email: 'rolled-back@example.test' } });
    throw new Error('rollback');
  }).catch(() => undefined);
  const rows = await prisma.user.findMany({ include: { posts: true }, orderBy: { id: 'asc' } });
  console.log('cjs', JSON.stringify(rows), Models.User);
  await shutdownPrisma();
};
void main();
