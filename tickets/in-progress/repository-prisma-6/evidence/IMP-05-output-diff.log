# Check: IMP-05 (AC-001: before/after output comparison)
# Command: for each pair, take the run output (after the header / after "--- output"), normalize it with the script below, then diff
# Commits: before 5528fc4, after 8ef7b77
# Date: 2026-11-04T17:10Z

--- normalize.sh
# Normalizes volatile parts of test:package output: temp directories, durations and the evidence header.
sed -E -e '/^# /d' -e '/^exit=/d' \
  -e 's#[^ "]*/repository-prisma-(package-smoke|esm-cjs-interop)-[A-Za-z0-9]+#<TMP-\1>#g' \
  -e 's/ in [0-9.]+m?s/ in <T>/g' "$1"

