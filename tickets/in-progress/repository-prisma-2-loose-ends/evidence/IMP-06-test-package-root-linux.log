# Check: IMP-06 (test:package as root and as non-root in Linux; Node 24 toolchain)
# Command: git archive e213742 | docker run --rm node:24 (image digest sha256:e7add2a490bb17d97b485b8641bd88455fff7839ade0f5eba493c3508124d413) bash run.sh
#   run.sh as root: npm ci; npm run typecheck; npm test; npm run test:package; then as user node (uid 1000): npm run test:package
# Commit: e213742
# Environment: Docker 29.0.1 linux/aarch64 on macOS host, Node v24.22.2, npm 11.19.1
# Date: 2026-11-04T16:39Z

--- run.sh
set -u
echo "## container: $(uname -sm), node $(node -v), npm $(npm -v), image node:24"
mkdir -p /work && cd /work && tar -xf /in/src.tar
chown -R node:node /work
echo; echo "## as root (uid $(id -u)): npm ci"
npm ci --no-fund 2>&1 | tail -6; echo "npm-ci exit=${PIPESTATUS[0]}"
echo; echo "## as root: npm run typecheck"; npm run typecheck >/dev/null 2>&1; echo "typecheck exit=$?"
echo; echo "## as root: npm test"; NO_COLOR=1 npm test 2>&1 | grep -E "Test Files|Tests "; echo "npm-test exit=${PIPESTATUS[0]}"
echo; echo "## as root: npm run test:package"; NO_COLOR=1 npm run test:package 2>&1 | grep -E '^skip:|"result"|Error|AssertionError'; echo "test-package exit=${PIPESTATUS[0]}"
echo; echo "## as non-root user node (uid $(id -u node)): npm run test:package"
chown -R node:node /work
su node -s /bin/bash -c 'cd /work && NO_COLOR=1 npm run test:package 2>&1 | grep -E "^skip:|\"result\"|Error|AssertionError"; echo "test-package exit=${PIPESTATUS[0]}"'
